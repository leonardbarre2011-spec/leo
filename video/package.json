{
  "name": "same-player",
  "version": "1.0.0",
  "private": true,
  "description": "SAME PLAYER — a 9:16 motion piece for a position-specific basketball training program.",
  "scripts": {
    "audio": "node scripts/build-audio.mjs",
    "start": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render SamePlayerShort render/same-player-short.mp4 --concurrency=4 --crf=17",
    "still": "remotion still SamePlayer",
    "upgrade": "remotion upgrade",
    "render:long": "remotion render SamePlayer render/same-player.mp4 --concurrency=4 --crf=17"
  },
  "dependencies": {
    "@remotion/cli": "4.0.410",
    "@remotion/media-utils": "4.0.410",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.410"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "ffmpeg-static": "^5.2.0",
    "typescript": "5.8.2"
  }
}
